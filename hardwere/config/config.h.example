#pragma once

// Copy to config.h and set values locally. Never commit config.h.
#define WIFI_SSID "CHANGE_ME"
#define WIFI_PASSWORD "CHANGE_ME"
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""
#define DEVICE_ID "AA:BB:CC:DD:EE:FF"

#define DHT_PIN 4
#define DHT_TYPE DHT22
#define SOIL_PIN 34
#define RAIN_PIN 35
#define WATER_TRIG_PIN 5
#define WATER_ECHO_PIN 18
#define RELAY_PIN 26

#define SOIL_DRY_VALUE 3200
#define SOIL_WET_VALUE 1200
// Measure these distances after installing the ultrasonic sensor.  The water
// percentage is 0% at EMPTY and 100% at FULL; do not reuse these values blindly.
#define WATER_EMPTY_DISTANCE_CM 30.0f
#define WATER_FULL_DISTANCE_CM 4.0f
#define MAX_PUMP_RUNTIME_SECONDS 300UL
#define TELEMETRY_INTERVAL_MS 60000UL
