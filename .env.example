# ==================================================
# AgriGuardian AI — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# ── Application ──────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_NAME="AgriGuardian AI"
APP_VERSION=0.1.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key-for-jwt

# ── Database (Neon PostgreSQL or Local) ───────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Database (SQLite for local dev — no Docker required)
DATABASE_URL=sqlite+aiosqlite:///./agri_guardian.db

# ── External APIs ─────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key
AGMARKET_API_KEY=your-agmarket-api-key
INDIA_GOV_API_KEY=your-india-gov-api-key
DISASTER_ALERT_API_KEY=your-disaster-api-key

# ── AI Engine ─────────────────────────────────────
AI_MODEL_PATH=ai/models
AI_PREDICTION_THRESHOLD=0.75

# ── Frontend ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME="AgriGuardian AI Dashboard"

# ── Logging ───────────────────────────────────────
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
