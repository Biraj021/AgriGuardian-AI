# AgriGuardian AI Configuration & Environment Variables Template
APP_ENV=development
APP_NAME=AgriGuardian AI
APP_VERSION=0.1.0
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database connection (SQLite for local development, asyncpg for PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./agri_guardian.db

# External API keys
OPENWEATHER_API_KEY=
AGMARKET_API_KEY=
INDIA_GOV_API_KEY=
DISASTER_ALERT_API_KEY=

# Multimodal Gemini Vision AI
# Get your key at: https://aistudio.google.com/app/apikey
# Key format: starts with "AQ." (newer keys) or "AIza..." (older format)
GEMINI_API_KEY=
# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# AI & Hardware settings
AI_MODEL_PATH=ai/models
AI_PREDICTION_THRESHOLD=0.75
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
